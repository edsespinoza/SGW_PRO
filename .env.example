# SGW Pro — Environment Variables (obrigatório para Docker)

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sgwpro
DB_USER=sgwpro
DB_PASSWORD=changeme_s3cur3_p4ss

# JWT — obrigatório, mínimo 32 caracteres
JWT_SECRET=changeme_jwt_secret_64_chars_min

# Encryption (master key para AES-256-GCM) — obrigatório, mínimo 32 caracteres
ENCRYPTION_KEY=changeme_enc_key_64_chars_hex_min

# Admin password — opcional. Se definido, cria usuário admin na primeira execução
ADMIN_PASSWORD=changeme_admin_password_8chars_min

# Anthropic API (ExtractorBatch via proxy seguro — a chave nunca vai pro browser)
ANTHROPIC_API_KEY=sk-ant-placeholder

# Allowed CORS origin
ALLOWED_ORIGIN=http://localhost:8081
